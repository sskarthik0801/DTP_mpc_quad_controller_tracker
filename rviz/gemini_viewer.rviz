Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Gemini color
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /gemini/color/image_raw
      Transport Hint: compressed
  Enabled: true
  Global Options:
    Fixed Frame: gemini_color_optical_frame
    Frame Rate: 15
  Name: root
  Tools: []
Window Geometry:
  Height: 720
  Width: 1000
