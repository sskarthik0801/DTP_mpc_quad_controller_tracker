+
+            dtp_msgs::msg::GoalStatus out;
+            out.header.stamp = nh_->get_clock()->now();
+            out.header.frame_id = msg->header.frame_id;
+            out.status = static_cast<uint8_t>(status);
+            out.goal_p.x = adopted.x();
