+        void followGoalCallback(const geometry_msgs::msg::PoseStamped::SharedPtr msg) {
+            const Vec3f goal_p{msg->pose.position.x, msg->pose.position.y, msg->pose.position.z};
+            const super_utils::Quatf q{msg->pose.orientation.w, msg->pose.orientation.x,
+                                       msg->pose.orientation.y, msg->pose.orientation.z};
