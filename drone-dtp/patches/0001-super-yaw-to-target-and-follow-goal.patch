+            // Deeply occupied: keep the previous goal (same as upstream) but SAY SO.
+            out_goal_p = gi_.goal_p;
+            return GOAL_DROPPED;
+        }
+
+        const bool snapped_away = (snapped - p).norm() > 1e-6;
+
+        gi_.goal_p = snapped;
+        gi_.goal_yaw = yaw;
+        gi_.new_goal = true;
+        started_ = true;
+        out_goal_p = gi_.goal_p;
+
+        return snapped_away ? GOAL_SNAPPED : GOAL_ACCEPTED;
+    }
+
     void Fsm::ChangeState(const string &call_func, const MACHINE_STATE &new_state) {
         fmt::print(fg(fmt::color::green), " -- [Fsm]: [{}] change state from [{}] to [{}].\n", call_func,
                    MACHINE_STATE_STR[int(machine_state_)], MACHINE_STATE_STR[int(new_state)]);
