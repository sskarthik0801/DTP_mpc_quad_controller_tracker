+void ProbMap::updateProbMap(const PointCloud& cloud, const Pose& pose, const TargetExclusion& exclusion) {
+    // Scoped to this one scan: reset on the way out, so a scan that arrives without a target can
+    // never inherit the previous scan's cylinder.
+    frame_exclusion_ = exclusion;
+    updateProbMap(cloud, pose);
+    frame_exclusion_ = TargetExclusion{};
+}
+
+bool ProbMap::cellInsideExclusion(const Vec3i& id_g) const {
+    Vec3f c;
+    globalIndexToPos(id_g, c);
+    if (c.z() < frame_exclusion_.z_min || c.z() > frame_exclusion_.z_max) {
+        return false;
+    }
+    const double dx = c.x() - frame_exclusion_.cx;
+    const double dy = c.y() - frame_exclusion_.cy;
+    return dx * dx + dy * dy <= frame_exclusion_.radius * frame_exclusion_.radius;
+}
+
+bool ProbMap::segmentMayCrossExclusion(const Vec3f& a, const Vec3f& b) const {
+    // Conservative pre-test, so the per-cell test runs only on the few rays that pass near the
+    // person: a ray can visit a cell whose centre is inside the cylinder while itself passing up to
+    // half a cell diagonal (horizontally) or half a cell (vertically) outside it.
+    const double half = 0.5 * cfg_.resolution;
+    if (std::max(a.z(), b.z()) < frame_exclusion_.z_min - half ||
+        std::min(a.z(), b.z()) > frame_exclusion_.z_max + half) {
+        return false;
+    }
+    const double reach = frame_exclusion_.radius + half * M_SQRT2 + 1e-6;
+    const double abx = b.x() - a.x(), aby = b.y() - a.y();
+    const double len2 = abx * abx + aby * aby;
+    double t = 0.0;
+    if (len2 > 1e-12) {
+        t = ((frame_exclusion_.cx - a.x()) * abx + (frame_exclusion_.cy - a.y()) * aby) / len2;
+        t = std::min(1.0, std::max(0.0, t));
+    }
+    const double dx = a.x() + t * abx - frame_exclusion_.cx;
+    const double dy = a.y() + t * aby - frame_exclusion_.cy;
+    return dx * dx + dy * dy <= reach * reach;
+}
