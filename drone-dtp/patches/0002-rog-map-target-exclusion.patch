diff --git a/super_planner/config/follow_test_ros2.yaml b/super_planner/config/follow_test_ros2.yaml
index 9db46ff..a940686 100644
--- a/super_planner/config/follow_test_ros2.yaml
+++ b/super_planner/config/follow_test_ros2.yaml
@@ -208,3 +208,31 @@ rog_map:
     # in all, 1.0 is more aggressive while 0.0 is more conservative.
     unk_thresh: 1.0
 
+  # M5.3a (DTP) target-point filter (docs/m5-m6-plan.md M5.3 item 1). While the followed person is
+  # SEEN (locked, not coasted, not a held frame) their own LiDAR returns are kept out of this map:
+  # inside a vertical cylinder around them a scan adds no hits and no misses, so they leave no trail
+  # of occupied cells and do not erode an obstacle they stand next to. Rays up to the cylinder still
+  # clear the line of sight in front of them.
+  # CONSEQUENCE: the planner does NOT avoid the followed person. What keeps the drone off them is
+  # follow_planner's standoff (>= 2.5 m) and command_mux's proximity veto, which reads /dtp/targets
+  # directly. Never enable this in a config flown without that stack (click/NAV configs).
+  target_exclusion:
+    enable: false
+    topic: "/dtp/follow_target"
+    # Numbers from drone-dtp/scripts/target_filter_study.py on ~/dtp_datasets/20260909_closedloop_run5
+    # (bench, stationary rig, subject p50 0.37 m/s), centre = position + velocity * (t_scan - t_target):
+    #  - centre to the person's LiDAR median: 0.18 m p50, 0.52 m p95;
+    #  - share of the person's points inside, p5 over scans: r 0.5 -> 0.41, 0.6 -> 0.71, 0.7 -> 0.92.
+    #    One escaped point is one occupied cell (a single hit crosses p_occ), so coverage matters.
+    radius: 0.6
+    # The target's z is perception's torso sample at 0.65 of the box height FROM THE TOP (near the
+    # waist), not the torso centre: the person's returns span -0.20 (p1) .. +1.18 m (p99) around it.
+    z_below: 1.0
+    z_above: 1.3
+    # Newest seen observation vs the scan's stamp: p50 0.29 s, p95 0.34 s. Older -> no filter.
+    # Not longer: past 0.4 s the extrapolated centre degrades fast (offset p50 0.17 -> 0.34-0.47 m,
+    # coverage p5 at r 0.6 0.71-0.79 -> 0.43 and then 0.00). Holds are covered only up to this.
+    max_age: 0.5
+    # A velocity above this is treated as a bad estimate and the observation is ignored.
+    max_speed: 3.0
+
