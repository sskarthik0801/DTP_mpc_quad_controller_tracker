+  # ROG-Map casts rays only to returns. A beam that returns nothing (sky) clears nothing, so a
+  # person seen from the GROUNDED aircraft -- sensor 0.15 m up, all of them above the horizon --
+  # leaves occupied cells no ray ever crosses again: on the 2026-09-14 bags 113 of 457 such
+  # cells were still there 7 min after the walker left. This pass sweeps occupied cells within
+  # range_max, and one that is inside the sensor's vertical field of view, has no observed
+  # occupied cell in the way, and that NO ray has reached for window_s (hit or miss -- a ray
+  # that does cross it is evidence ROG-Map already weighs) -- and long enough that the sensor
+  # would have sent min_expected_rays through it -- receives, every period_s, as many misses
+  # as rays it should have seen (rays_per_sr_s * 0.1^2 / r^2 * period_s). A real surface in
+  # view keeps returning hits and is never touched; neither is anything occluded, out of view
+  # or beyond range_max. Gate: drone-dtp/scripts/unhit_decay_check.py: a walker's cells 3.1 m
+  # away with sky behind are gone 7 s after they leave; pass cost 3-4 ms, max 10 ms.
+  unhit_decay:
+    enable: true
+    range_max: 8.0
+    # MID360: -7 .. +52 deg, 1 deg inside so a cell on the edge of the pattern is not judged.
+    fov_elev_min_deg: -6.0
+    fov_elev_max_deg: 50.0
+    window_s: 3.0
+    period_s: 0.5
+    scan_rate_hz: 10.0
+    # Rays reaching ROG-Map per steradian per second: the MID360's ~200k pts/s over its 5.72 sr
+    # field of view, / FAST-LIO's point_filter_num 3 = 11.7k; 10k is deliberately a little low.
+    # Must include every downsampling between the sensor and this map (point_filt_num above too).
+    rays_per_sr_s: 10000.0
+    # At 3 m a cell sees ~11 rays/s (window 3 s); at 6 m 2.8/s (7 s); at 8 m 1.6/s (13 s).
+    min_expected_rays: 20.0
+    max_miss_per_pass: 50
+
 # M6.1 (DTP) loss oracle (docs/m5-m6-plan.md SS5.0; drone-dtp/docs: docs/m6-loss-oracle.md).
 # Answers every COASTING /dtp/follow_target with a dtp_msgs/LossEvent on /planning/loss_event:
 # OCCLUDED / UNMAPPED / LOST / OUT_OF_VIEW, plus the reappearance belief and a pre-positioning
