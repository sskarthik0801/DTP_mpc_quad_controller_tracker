+bool ProbMap::unhitLineOfSightClear(const Vec3f& sensor, const Vec3f& cell_center) {
+    // Every cell from the ray start (raycast_range_min from the sensor, where ordinary rays start
+    // too) up to but excluding the cell itself must not be a virtual plane, the map edge, or an
+    // OCCUPIED cell that has been hit within the last decay period. UNKNOWN does not block: an
+    // unknown cell on the line to a cell that WAS hit is the discretised line grazing a body's
+    // never-scanned interior (a tangent cell of a person is reached by real rays that miss the
+    // interior by less than a cell), or space no ray has ever returned from -- and in the field of
+    // view, within range, "no return" is exactly the evidence this decay acts on. Nor does an
+    // occupied cell that is itself going unhit: if there were matter in it the rays would return
+    // from it, so the layers of a remnant decay together instead of one per window. A real
+    // occluder in view returns hits every scan and blocks.
+    const Vec3f d = cell_center - sensor;
+    const double r = d.norm();
+    if (r <= cfg_.raycast_range_min) {
+        return true;
+    }
+    const Vec3f start = sensor + d * (cfg_.raycast_range_min / r);
+    if (!decay_raycaster_.setInput(start, cell_center)) {
+        return true;
+    }
+    Vec3f pt;
+    Vec3i id_g;
+    while (decay_raycaster_.step(pt)) {
+        posToGlobalIndex(pt, id_g);
+        if (!insideLocalMap(id_g) ||
+            id_g.z() <= sc_.virtual_ground_height_id_g || id_g.z() >= sc_.virtual_ceil_height_id_g) {
+            return false;
+        }
+        const int h = getHashIndexFromGlobalIndex(id_g);
+        if (isOccupied(occupancy_buffer_[h]) && unhit_passes_[h] < 2) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void ProbMap::unhitDecayPass(const Pose& pose) {
+    const auto t0 = std::chrono::steady_clock::now();
+    const Vec3f& sensor = pose.first;
+    const Mat3f R_bw = pose.second.toRotationMatrix().transpose();   // world -> sensor body
+    const double res = cfg_.resolution;
+    const double r_max = cfg_.unhit_decay_range_max;
+    const double r_min = cfg_.raycast_range_min + res;
+    const double sqr_r_max = r_max * r_max, sqr_r_min = r_min * r_min;
+    const double sin_lo = std::sin(cfg_.unhit_decay_elev_min_deg * M_PI / 180.0);
+    const double sin_hi = std::sin(cfg_.unhit_decay_elev_max_deg * M_PI / 180.0);
+    const double period_s = cfg_.unhit_decay_period_frames / cfg_.unhit_decay_scan_rate_hz;
+    // rays per second through a cell of cross-section res^2 at range r: rays_per_sr_s * res^2 / r^2
+    const double rays_area = cfg_.unhit_decay_rays_per_sr_s * res * res;
+
+    Vec3i lo_i, hi_i;
+    posToGlobalIndex(sensor - Vec3f::Constant(r_max), lo_i);
+    posToGlobalIndex(sensor + Vec3f::Constant(r_max), hi_i);
+    lo_i = lo_i.cwiseMax(local_map_bound_min_i_);
+    hi_i = hi_i.cwiseMin(local_map_bound_max_i_);
+    lo_i.z() = std::max(lo_i.z(), sc_.virtual_ground_height_id_g + 1);
+    hi_i.z() = std::min(hi_i.z(), sc_.virtual_ceil_height_id_g - 1);
+    if ((hi_i - lo_i).minCoeff() < 0) {
+        return;
+    }
+
+    // The buffer is hashed (lx + hx) * sy * sz + (ly + hy) * sz + (lz + hz) with the local index
+    // the global one wrapped into [-h, h] (SlidingMap::getLocalIndexHash), so a column is walked
+    // by stepping lz and wrapping once, without hashing every cell.
+    const int sz = sc_.map_size_i.z(), hz = sc_.half_map_size_i.z();
+    const int sy = sc_.map_size_i.y(), hy = sc_.half_map_size_i.y(), hx = sc_.half_map_size_i.x();
+    long candidates = 0, visible = 0, decayed = 0, emptied = 0;
+    Vec3i id_g, id_l;
+    Vec3f c;
+    for (id_g.x() = lo_i.x(); id_g.x() <= hi_i.x(); id_g.x()++) {
+        for (id_g.y() = lo_i.y(); id_g.y() <= hi_i.y(); id_g.y()++) {
+            id_g.z() = lo_i.z();
+            globalIndexToPos(id_g, c);
+            const double cx = c.x() - sensor.x(), cy = c.y() - sensor.y();
+            const double sqr_h = cx * cx + cy * cy;
+            if (sqr_h > sqr_r_max) {
+                continue;
+            }
+            // only the part of the column inside the range_max sphere
+            const double dz_max = std::sqrt(std::max(0.0, sqr_r_max - sqr_h));
+            int z_lo, z_hi;
+            posToGlobalIndex(sensor.z() - dz_max, z_lo);
+            posToGlobalIndex(sensor.z() + dz_max, z_hi);
+            z_lo = std::max(z_lo, lo_i.z());
+            z_hi = std::min(z_hi, hi_i.z());
+            if (z_hi < z_lo) {
+                continue;
+            }
+            id_g.z() = z_lo;
+            globalIndexToLocalIndex(id_g, id_l);
+            const int base = (id_l.x() + hx) * sy * sz + (id_l.y() + hy) * sz + hz;
+            int lz = id_l.z();
+            for (id_g.z() = z_lo; id_g.z() <= z_hi; id_g.z()++, lz = (lz + 1 > hz) ? lz + 1 - sz : lz + 1) {
+                const int h = base + lz;
+                const float v = occupancy_buffer_[h];
+                const bool occ = isOccupied(v);
+                if (!occ) {
+                    if (unhit_passes_[h] == 0) {
+                        continue;                 // free or unknown space is not ours to touch
+                    }
+                    if (isKnownFree(v)) {
+                        unhit_passes_[h] = 0;     // done: ordinary rays or this pass freed it
+                        continue;
+                    }
+                    // unknown, but emptied by this pass and unhit since: keep going until free
+                }
+                const double cz = (id_g.z() + 0.5) * res - sensor.z();
+                const double sqr_r = sqr_h + cz * cz;
+                if (sqr_r > sqr_r_max || sqr_r < sqr_r_min) {
+                    continue;
+                }
+                const Vec3f d(cx, cy, cz);
+                const double r = std::sqrt(sqr_r);
+                const double s = (R_bw * d).z() / r;      // sine of the elevation in the sensor frame
+                if (s < sin_lo || s > sin_hi) {
+                    continue;
+                }
+                candidates++;
+                uint8_t& n = unhit_passes_[h];
+                if (n == 0) {
+                    n = 1;                        // first look since a ray last reached it: start the clock
+                    continue;
+                }
+                if (n < 255) {
+                    n++;
+                }
+                const double t_unhit = (n - 1) * period_s;
+                const double rate = rays_area / sqr_r;
+                if (t_unhit < cfg_.unhit_decay_window_s || rate * t_unhit < cfg_.unhit_decay_min_expected_rays) {
+                    continue;
+                }
+                // Due. The line-of-sight walk runs only now, so a real surface -- hit again long
+                // before its window is up -- never pays for one. Blocked: no misses this pass; the
+                // clock keeps running, and a real object that comes back into view is hit again
+                // before the next pass and resets it.
+                c = sensor + d;
+                if (!unhitLineOfSightClear(sensor, c)) {
+                    continue;
+                }
+                visible++;
+                const int misses = std::max(1, std::min(cfg_.unhit_decay_max_miss_per_pass,
+                                                        (int) std::lround(rate * period_s)));
+                missPointUpdate(c, h, misses);
+                decayed++;
+                if (occ && !isOccupied(occupancy_buffer_[h])) {
+                    emptied++;
+                }
+                if (isKnownFree(occupancy_buffer_[h])) {
+                    n = 0;
+                }
+            }
+        }
+    }
+    unhit_stats_.passes++;
+    unhit_stats_.candidates += candidates;
+    unhit_stats_.visible += visible;
+    unhit_stats_.decayed += decayed;
+    unhit_stats_.emptied += emptied;
+    unhit_stats_.last_pass_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    unhit_stats_.max_pass_ms = std::max(unhit_stats_.max_pass_ms, unhit_stats_.last_pass_ms);
+}
+
