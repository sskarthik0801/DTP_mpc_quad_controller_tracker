+        // The viewpoint sweep of evaluate(), run for EVERY azimuth and reported whole instead of
+        // reduced to its winner. Per bin: how far out from standoff_near a viewpoint stays clear
+        // of the INFLATED occupancy (what SUPER would accept as a goal), then from that
+        // viewpoint one ray to each height of the person the map can know. Reads the map, never
+        // writes it, draws no random numbers, and does not touch evaluate(): the LossEvent
+        // stream stays bit-for-bit what it was.
+        VisField visibilityField(const Vec3f &centre, const Vec3f &body_p, const Quatf &body_q,
+                                 const std::vector<Vec3f> &trail = std::vector<Vec3f>{}) const {
+            using clock = std::chrono::steady_clock;
+            const auto t0 = clock::now();
+            trail_ = &trail;
+            VisField f;
+            f.centre_p = centre;
+            const Eigen::Matrix3d R = body_q.normalized().toRotationMatrix();
+            const Vec3f cam_off(p_.camera_offset_body[0], p_.camera_offset_body[1], p_.camera_offset_body[2]);
+            f.camera_p = body_p + R * cam_off;
+
+            // The same floor evaluate() applies: nothing under the virtual ground, and nothing
+            // under the LiDAR's downward view limit at the person's range. Unlike evaluate(),
+            // no stand-in height is invented when all are dropped: heights_used 0 means "this
+            // field says nothing", and the consumer must read it that way.
+            const double d_t = std::hypot(centre.x() - f.camera_p.x(), centre.y() - f.camera_p.y());
+            const double z_floor = std::max(ground_z_ + res_,
+                                            f.camera_p.z() - d_t * std::tan(p_.fov_floor_deg * M_PI / 180.0) + res_);
+            std::vector<double> heights;
+            for (const double dz : p_.vis_sample_dz) {
+                const double z = centre.z() + dz;
+                if (z <= z_floor || z >= ceil_z_ - res_) {
+                    ++f.heights_dropped;
+                } else {
+                    heights.push_back(z);
+                }
+            }
+            f.heights_used = static_cast<int>(heights.size());
+            f.view_z = std::min(std::max(centre.z() + p_.viewpoint_height_offset, p_.viewpoint_z_min),
+                                p_.viewpoint_z_max);
+
+            const double step = std::max(1.0, p_.viewpoint_az_step_deg) * M_PI / 180.0;
+            const int bins = std::max(1, static_cast<int>(std::lround(2.0 * M_PI / step)));
