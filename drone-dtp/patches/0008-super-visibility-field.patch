+                const double ca = std::cos(az), sa = std::sin(az);
+                double clear = -1.0;
+                for (double rad = p_.standoff_near; rad <= p_.standoff_far + 1e-9; rad += res_) {
+                    const GridType gt = map_->getInfGridType(Vec3f(centre.x() + rad * ca, centre.y() + rad * sa, f.view_z));
+                    if (gt == GridType::OCCUPIED || gt == GridType::OUT_OF_MAP) break;
+                    clear = rad;
+                }
+                if (clear < 0.0) continue;                 // not even the near edge: stays NaN
+                f.clear_r[b] = static_cast<float>(clear);
+                if (heights.empty()) continue;
+                const double rv = std::min(clear, r_mid);
+                const int n_sub = std::max(1, p_.vis_sub_az);
+                int n_free = 0, n_unk = 0, n_rays = 0;
+                for (int j = 0; j < n_sub; ++j) {
+                    const double a = az + f.daz * ((j + 0.5) / n_sub - 0.5);   // evenly across the bin
+                    const Vec3f q(centre.x() + rv * std::cos(a), centre.y() + rv * std::sin(a), f.view_z);
+                    for (const double z : heights) {
