+                        // UNKNOWN beside a known obstacle is not "cannot know". ROG-Map holds a
+                        // trunk as a one-cell shell of the face the sensor lit; a ray from any
+                        // other viewpoint grazes past that shell into the trunk's unseen side,
+                        // and its first non-free cell reads UNKNOWN. If the INFLATED map calls
+                        // that cell occupied, it is within the inflation radius of a surface the
+                        // sensor did see: inside the obstacle, to every purpose. Without this a
+                        // tube dead between the viewpoint and the person read 0.56 blocked, not
+                        // 1.0 (visibility_field_check V9). evaluate() is NOT given this rule:
+                        // the LossEvent stream stays bit for bit what it was.
+                        if (lab == RAY_UNK && map_->getInfGridType(hit) == GridType::OCCUPIED) lab = RAY_OCC;
+                        ++n_rays;
+                        if (lab == RAY_FREE) ++n_free;
+                        else if (lab == RAY_UNK) ++n_unk;
+                    }
+                }
+                f.vis[b] = static_cast<float>(n_free) / n_rays;
